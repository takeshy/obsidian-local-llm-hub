{
  "name": "obsidian-local-llm-hub",
  "version": "0.19.3",
  "description": "Chat with local LLMs via OpenAI-compatible API, with local embeddings RAG and text processing commands",
  "main": "main.js",
  "scripts": {
    "generate:builtin-okf": "node scripts/generate-builtin-okf.mjs",
    "dev": "npm run generate:builtin-okf && node esbuild.config.mjs",
    "build": "npm run generate:builtin-okf && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "INTEGRATION=1 vitest run src/core/ragStore.integration.test.ts",
    "lint": "eslint .",
    "preversion": "npm run lint && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "local-llm",
    "ollama",
    "rag"
  ],
  "author": "takeshy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takeshy/obsidian-local-llm-hub.git"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/json": "0.14.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.28.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.1",
    "tslib": "^2.4.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "fflate": "^0.8.3",
    "lucide-react": "^0.503.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
